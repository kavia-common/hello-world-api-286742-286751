# Example environment variables for flask_backend
# Do NOT commit real secrets here.

# Port for Flask app (optional; defaults to 3001)
PORT=3001

# Path to a Netscape-format cookies.txt file for yt-dlp (optional)
# YTDLP_COOKIES_FILE=/absolute/path/to/cookies.txt

# API key for Groq (required for /summarize endpoint)
# Obtain from https://console.groq.com/
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
