# Convenience targets for local dev

# PUBLIC_INTERFACE
# start: Start the Flask app on port 3001 using the repo-level .venv if present.
start:
	. ../../.venv/bin/activate && python run.py

# PUBLIC_INTERFACE
# lint: Run flake8 on this backend folder using the repo-level .venv if present.
lint:
	. ../../.venv/bin/activate && flake8 .
